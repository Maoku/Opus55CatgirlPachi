{
  "name": "opus55-catgirl-pachi",
  "private": true,
  "version": "0.1.0",
  "description": "猫耳キャラ パチンコ (ブラウザ版) — TypeScript + WebGL2 + Rapier2D",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:long": "playwright test --project=long"
  },
  "dependencies": {
    "@dimforge/rapier2d-deterministic-compat": "0.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "source-map-js@1.2.1": "1.2.2"
  }
}
